{
  "manifest_version": 2,
  "id": "local.wake-call",
  "version": "1.0.1",
  "plugin_type": "automation",
  "name": "麦麦电话闹钟",
  "description": "到点给你的手机打一通真的电话：模型按提示词生成一句话，TTS 合成后由 baresip 发起 SIP 呼叫，手机弹出原生来电界面，不依赖 QQ 通道，QQ 掉线也不会错过。只单向播放，不能对话，台词播完自动挂断。五分钟能跑通：注册一个 sip2sip 账号 → 手机装 Linphone → 填两项配置。支持多个定时任务（各自时间与提示词）、四家 TTS（edge / OpenAI 兼容 / MiniMax / 豆包，某家失败自动退回 edge）、台词守门与字数硬限制、内网直呼分层发现（对方换 IP 也能找回，公共网络自动收敛扫描），也可部署到公网云服务器走自建 SIP。",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "phone-call",
      "background": "#B2EBF2"
    }
  },
  "author": {
    "name": "mamaipiye",
    "url": "https://github.com/mamaipiye"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/mamaipiye/maibot-wake-call",
    "homepage": "https://github.com/mamaipiye/maibot-wake-call",
    "documentation": "https://github.com/mamaipiye/maibot-wake-call#readme",
    "issues": "https://github.com/mamaipiye/maibot-wake-call/issues"
  },
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.22.0",
    "max_version": "2.50.50"
  },
  "dependencies": [],
  "capabilities": [
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
